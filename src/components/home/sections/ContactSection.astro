---
import type { Lang } from '../../../i18n/config.i18n';
import homeContent from '../../../data/site-home-content.json';
import globalContent from '../../../data/site-global-content.json';
import PhoneInput from '../../common/PhoneInput.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeContent[lang] ?? homeContent.es;
const g = globalContent[lang] ?? globalContent.es;

const contactHeading = lang === 'es' ? 'Contáctanos' : 'Contact Us';
const optionalLabel = lang === 'es' ? '(opcional)' : '(optional)';
const sendingText = lang === 'es' ? 'Enviando...' : 'Sending...';
---

<section id="contacto" class="relative bg-white py-14">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Overlapping dark navy pill header -->
    <div class="relative z-20 -mt-9 mx-auto max-w-3xl bg-[#0F3D6E] text-white rounded-xl px-8 py-4 text-center" data-animate="fade-up">
      <h2 class="text-lg sm:text-xl font-bold tracking-tight">
        {t.contactBanner.title}
      </h2>
    </div>

    <!-- 2-column layout below -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left: Contact info -->
      <div class="lg:col-span-5" data-animate="slide-in-left">
        <h3 class="text-2xl sm:text-3xl font-semibold text-[#0072B5] border-b border-[#0072B5] pb-3 mb-6">
          {contactHeading}
        </h3>

        <div class="space-y-5 text-sm text-slate-600">
          <!-- Guatemala Address -->
          <div class="flex items-start gap-3.5">
            <svg class="w-5 h-5 text-[#5B9BD5] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <div class="leading-relaxed">
              <p>Zona de negocios San Nicolas</p>
              <p>11 calle 6-11 El Llano, zona 4 de Mixco Bodega 25</p>
            </div>
          </div>

          <!-- US Phone -->
          <div class="flex items-center gap-3.5">
            <svg class="w-5 h-5 text-[#5B9BD5] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18M3 4.5h13.5l-2.25 4.5 2.25 4.5H3" />
            </svg>
            <a href={`tel:${g.footer.usPhone.replace(/[^+\d]/g, '')}`} class="hover:text-[#0072B5] transition-colors">
              {g.footer.usPhone}
            </a>
          </div>

          <!-- GT Phone -->
          <div class="flex items-center gap-3.5">
            <svg class="w-5 h-5 text-[#5B9BD5] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <a href={`tel:${g.footer.gtPhone.replace(/[^+\d]/g, '')}`} class="hover:text-[#0072B5] transition-colors">
              {g.footer.gtPhone}
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Interactive distribution form -->
      <div class="lg:col-span-7" data-animate="slide-in-right" data-animate-delay="100">
        <form
          class="proexport-contact-form space-y-4"
          data-sending-text={sendingText}
          data-submit-text={t.contactForm.submit}
          data-success-text={t.contactForm.successMessage}
          data-error-text={t.contactForm.errorMessage}
        >
          <div>
            <label for="contact-fullName" class="block text-sm font-medium text-[#0072B5] mb-1.5">
              {t.contactForm.fullName}
            </label>
            <input
              id="contact-fullName"
              name="fullName"
              type="text"
              required
              class="w-full bg-[#EFEFEF] border-0 rounded-sm px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0072B5]/30"
            />
          </div>

          <div>
            <label for="contact-company" class="block text-sm font-medium text-[#0072B5] mb-1.5">
              {t.contactForm.company}
            </label>
            <input
              id="contact-company"
              name="company"
              type="text"
              required
              class="w-full bg-[#EFEFEF] border-0 rounded-sm px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0072B5]/30"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-sm font-medium text-[#0072B5] mb-1.5">
              {t.contactForm.email}
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              class="w-full bg-[#EFEFEF] border-0 rounded-sm px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0072B5]/30"
            />
          </div>

          <div>
            <label for="contact-phone" class="block text-sm font-medium text-[#0072B5] mb-1.5">
              {t.contactForm.phone}
            </label>
            <PhoneInput id="contact-phone" name="phone" lang={lang} required />
          </div>

          <div>
            <label for="contact-message" class="block text-sm font-medium text-[#0072B5] mb-1.5">
              {t.contactForm.message} {optionalLabel}
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows={6}
              class="w-full bg-[#EFEFEF] border-0 rounded-sm px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0072B5]/30"
            ></textarea>
          </div>

          <div class="contact-feedback hidden rounded-sm px-4 py-3 text-sm font-medium" role="status" aria-live="polite"></div>

          <div>
            <button
              type="submit"
              class="contact-submit-btn bg-[#0072B5] hover:bg-[#0F3D6E] text-white text-sm font-medium px-7 py-2 rounded-sm transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
            >
              {t.contactForm.submit}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { actions } from 'astro:actions';

  function initContactForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('.proexport-contact-form');
    forms.forEach((form) => {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const submitBtn = form.querySelector<HTMLButtonElement>('.contact-submit-btn');
      const feedback = form.querySelector<HTMLElement>('.contact-feedback');
      const sendingText = form.dataset.sendingText || 'Sending...';
      const submitText = form.dataset.submitText || 'Send';
      const successText = form.dataset.successText || 'Sent!';
      const errorText = form.dataset.errorText || 'Error';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!submitBtn || !feedback) return;

        const formData = new FormData(form);
        const dialCode = String(formData.get('phoneDialCode') || '').trim();
        const rawPhone = String(formData.get('phone') || '').trim();
        const phone = rawPhone ? (dialCode ? `${dialCode} ${rawPhone}` : rawPhone) : '';
        const payload = {
          fullName: String(formData.get('fullName') || ''),
          company: String(formData.get('company') || ''),
          email: String(formData.get('email') || ''),
          phone,
          message: String(formData.get('message') || ''),
        };

        submitBtn.disabled = true;
        submitBtn.textContent = sendingText;
        feedback.classList.add('hidden');
        feedback.classList.remove('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200', 'bg-red-50', 'text-red-800', 'border-red-200');

        try {
          const { data, error } = await actions.sendContactForm(payload);
          if (error || !data?.data?.sent) {
            feedback.textContent = errorText;
            feedback.classList.remove('hidden');
            feedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
          } else {
            feedback.textContent = successText;
            feedback.classList.remove('hidden');
            feedback.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
            form.reset();
          }
        } catch {
          feedback.textContent = errorText;
          feedback.classList.remove('hidden');
          feedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = submitText;
        }
      });
    });
  }

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
