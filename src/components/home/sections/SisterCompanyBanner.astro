---
import type { Lang } from '../../../i18n/config.i18n';
import homeContent from '../../../data/site-home-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeContent[lang] ?? homeContent.es;
const sc = t.sisterCompany;
---

<section class="bg-navy text-white py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 items-center gap-8 md:gap-12">
      <!-- Left: White paragraph about CAD Import Inc. (+2,000 stores) -->
      <div class="md:col-span-8 space-y-3" data-animate="slide-in-left">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-gold">
          {sc.tag}
        </p>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
          {sc.title} <span class="text-gold font-extrabold">{sc.highlightNumber}</span>{' '}
          <span class="text-base sm:text-lg font-semibold text-sky-200">{sc.highlightLabel}</span>
        </h2>
        <p class="text-base sm:text-lg leading-relaxed text-white/90 max-w-3xl">
          {sc.description}
        </p>
        <div class="pt-2">
          <a
            href={`/${lang}/${sc.ctaPath}`}
            class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-gold hover:text-white transition-colors"
          >
            {sc.ctaText}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Circular white badge containing CAD seal -->
      <div class="md:col-span-4 flex justify-center md:justify-end" data-animate="bubble-pop" data-animate-delay="200">
        <div class="w-40 h-40 sm:w-44 sm:h-44 rounded-full bg-white flex items-center justify-center p-6 shadow-xl ring-4 ring-white/20">
          <img
            src={sc.sealImage}
            alt={sc.title}
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
