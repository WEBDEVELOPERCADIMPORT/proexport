---
import type { Lang } from '../../../i18n/config.i18n';
import type { Brand } from '../../../actions/brands/getBrands.action';
import homeContent from '../../../data/site-home-content.json';

interface Props {
  lang: Lang;
  brands: Brand[];
}

const { lang, brands } = Astro.props;
const t = homeContent[lang] ?? homeContent.es;
---

<section class="bg-white py-14 md:py-18">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Centered heading with dual-tone blue/green underline -->
    <div class="text-center max-w-2xl mx-auto" data-animate="fade-up">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-accent tracking-tight">
        {t.brands.title}
      </h2>
      <div class="mt-3 mx-auto flex w-20 h-[3px] overflow-hidden rounded-full" aria-hidden="true">
        <span class="w-1/2 bg-accent"></span>
        <span class="w-1/2 bg-emerald-500"></span>
      </div>
      <p class="mt-4 text-sm sm:text-base text-slate-600">
        {t.brands.subtitle}
      </p>
    </div>

    <!-- Horizontal responsive row of 6 clickable brand logos -->
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 items-center">
      {
        brands.map((brand, idx) => {
          const delay = Math.min((idx % 5 + 1) * 100, 500);
          return (
            <a
              href={`/${lang}/productos/?brand=${brand.slug}`}
              class="group flex items-center justify-center p-2 bg-transparent transition-all duration-200 h-28"
              aria-label={brand.name}
              data-animate="bubble-pop"
              data-animate-delay={String(delay)}
            >
              <img
                src={brand.logo}
                alt={brand.name}
                class="max-h-20 sm:max-h-24 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
                loading="lazy"
              />
            </a>
          );
        })
      }
    </div>
  </div>
</section>
