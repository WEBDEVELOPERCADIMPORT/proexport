---
import type { Lang } from "../../i18n/config.i18n";
import globalContent from "../../data/site-global-content.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = globalContent[lang] ?? globalContent.es;
const { address, phone } = content.topBar;
const phoneHref = `tel:${phone.replace(/[^+\d]/g, "")}`;
---

<div class="w-full bg-white text-[#777777] text-xs py-2 px-4 sm:px-6">
  <div class="flex flex-wrap items-center justify-center lg:justify-end gap-x-6 gap-y-1">
    <div class="flex items-center gap-1.5">
      <svg
        class="w-3.5 h-3.5 text-accent shrink-0"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z"
          clip-rule="evenodd"
        />
      </svg>
      <span>{address}</span>
    </div>

    <a
      href={phoneHref}
      class="flex items-center gap-1.5 hover:text-accent transition-colors font-medium whitespace-nowrap"
    >
      <svg
        class="w-3.5 h-3.5 text-accent shrink-0"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z"
          clip-rule="evenodd"
        />
      </svg>
      <span>{phone}</span>
    </a>
  </div>
</div>
