---
import type { Lang } from '../../../i18n/config.i18n';
import contactContent from '../../../data/site-contact-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = contactContent[lang] ?? contactContent.es;
---

<aside class="bg-white p-2 sm:p-4">
  <img
    src="/images/home/proexport-logo-hz.svg"
    alt="Proexport Guatemala"
    class="mb-6 h-9 w-auto"
  />

  <ul class="space-y-5 text-sm text-slate-700">
    <li class="flex items-start gap-3">
      <svg
        class="mt-0.5 h-5 w-5 shrink-0 text-[#1D70B8]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-6-5.686-6-10a6 6 0 1112 0c0 4.314-6 10-6 10z" />
        <circle cx="12" cy="11" r="2.5" />
      </svg>
      <span>{t.info.address}</span>
    </li>

    <li class="flex items-center gap-3">
      <svg
        class="h-5 w-5 shrink-0 text-[#1D70B8]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-18 8h18a2 2 0 002-2V6a2 2 0 00-2-2H3a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <a
        href={`mailto:${t.info.email}`}
        class="font-medium text-[#0F3D6E] transition-colors hover:text-[#1D70B8]"
      >
        {t.info.email}
      </a>
    </li>

    <li class="flex items-center gap-3">
      <img
        src="/images/home/flag-gt.png"
        alt={t.info.gtPhoneLabel}
        class="h-4 w-6 shrink-0 rounded-xs object-cover"
      />
      <a
        href={`tel:${t.info.gtPhone.replace(/[^+\d]/g, '')}`}
        class="font-medium text-slate-700 transition-colors hover:text-[#1D70B8]"
      >
        {t.info.gtPhone}
      </a>
    </li>

    <li class="flex items-center gap-3">
      <img
        src="/images/home/flag-us.webp"
        alt={t.info.usPhoneLabel}
        class="h-4 w-6 shrink-0 rounded-xs object-cover"
      />
      <a
        href={`tel:${t.info.usPhone.replace(/[^+\d]/g, '')}`}
        class="font-medium text-slate-700 transition-colors hover:text-[#1D70B8]"
      >
        {t.info.usPhone}
      </a>
    </li>
  </ul>
</aside>
