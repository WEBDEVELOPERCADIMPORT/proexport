---
import type { Lang } from '../../../i18n/config.i18n';
import contactContent from '../../../data/site-contact-content.json';
import ContactInfoCard from '../components/ContactInfoCard.astro';
import PhoneInput from '../../common/PhoneInput.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = contactContent[lang] ?? contactContent.es;
---

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12">
    <div class="lg:col-span-7" data-animate="slide-in-left">
      <h2 class="mb-6 text-2xl font-bold text-[#0F3D6E] proexport-underline">
        {t.form.title}
      </h2>

      <form
        data-contact-form
        data-success-message={t.form.successMessage}
        data-error-message={t.form.errorMessage}
        class="space-y-4"
      >
        <div>
          <label for="contact-fullName" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-[#0072B5]">
            {t.form.fullName}
          </label>
          <input
            id="contact-fullName"
            name="fullName"
            type="text"
            required
            class="w-full rounded-sm border-0 bg-[#EFEFEF] px-4 py-2.5 text-sm text-slate-800 focus:ring-2 focus:ring-[#0072B5]/30 focus:outline-none"
          />
        </div>

        <div>
          <label for="contact-company" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-[#0072B5]">
            {t.form.company}
          </label>
          <input
            id="contact-company"
            name="company"
            type="text"
            required
            class="w-full rounded-sm border-0 bg-[#EFEFEF] px-4 py-2.5 text-sm text-slate-800 focus:ring-2 focus:ring-[#0072B5]/30 focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="contact-email" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-[#0072B5]">
              {t.form.email}
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              class="w-full rounded-sm border-0 bg-[#EFEFEF] px-4 py-2.5 text-sm text-slate-800 focus:ring-2 focus:ring-[#0072B5]/30 focus:outline-none"
            />
          </div>

          <div>
            <label for="contact-phone" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-[#0072B5]">
              {t.form.phone}
            </label>
            <PhoneInput id="contact-phone" name="phone" lang={lang} required />
          </div>
        </div>

        <div>
          <label for="contact-message" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-[#0072B5]">
            {t.form.message}
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            class="w-full rounded-sm border-0 bg-[#EFEFEF] px-4 py-2.5 text-sm text-slate-800 focus:ring-2 focus:ring-[#0072B5]/30 focus:outline-none"
          ></textarea>
        </div>

        <div
          data-contact-feedback
          class="hidden rounded px-4 py-3 text-sm font-medium"
          role="status"
          aria-live="polite"
        ></div>

        <button
          type="submit"
          data-contact-submit
          class="inline-flex items-center justify-center rounded-sm bg-[#0F3D6E] px-8 py-3 text-sm font-semibold uppercase tracking-wider text-white transition-colors hover:bg-[#0072B5] disabled:cursor-not-allowed disabled:opacity-60 cursor-pointer"
        >
          {t.form.submit}
        </button>
      </form>
    </div>

    <div class="lg:col-span-5">
      <ContactInfoCard lang={lang} />
    </div>
  </div>
</section>

<script>
  import { actions } from 'astro:actions';

  function initContactForm() {
    const forms = document.querySelectorAll<HTMLFormElement>('[data-contact-form]');
    forms.forEach((form) => {
      if (form.dataset.initialized === 'true') return;
      form.dataset.initialized = 'true';

      const feedback = form.querySelector<HTMLElement>('[data-contact-feedback]');
      const submitBtn = form.querySelector<HTMLButtonElement>('[data-contact-submit]');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!feedback || !submitBtn) return;

        submitBtn.disabled = true;
        feedback.classList.add('hidden');
        feedback.classList.remove('bg-emerald-50', 'text-emerald-700', 'bg-red-50', 'text-red-700');

        const formData = new FormData(form);
        const dialCode = String(formData.get('phoneDialCode') ?? '').trim();
        const rawPhone = String(formData.get('phone') ?? '').trim();
        const phone = rawPhone ? (dialCode ? `${dialCode} ${rawPhone}` : rawPhone) : '';
        const payload = {
          fullName: String(formData.get('fullName') ?? ''),
          company: String(formData.get('company') ?? ''),
          email: String(formData.get('email') ?? ''),
          phone,
          message: String(formData.get('message') ?? '').trim() || undefined,
        };

        const { data, error } = await actions.sendContactForm(payload);

        submitBtn.disabled = false;
        feedback.classList.remove('hidden');

        if (error || !data?.data?.sent) {
          feedback.textContent = form.dataset.errorMessage || 'Error sending message.';
          feedback.classList.add('bg-red-50', 'text-red-700');
          return;
        }

        feedback.textContent = form.dataset.successMessage || data.message;
        feedback.classList.add('bg-emerald-50', 'text-emerald-700');
        form.reset();
      });
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
