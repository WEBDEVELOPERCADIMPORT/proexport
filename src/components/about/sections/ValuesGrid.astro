---
import type { Lang } from '../../../i18n/config.i18n';
import aboutContent from '../../../data/site-about-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = aboutContent[lang] ?? aboutContent.es;
const v = t.values;
---

<section class="bg-slate-50 py-14 md:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Centered heading with golden underline -->
    <div class="text-center" data-animate="fade-up">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy tracking-tight proexport-underline-center">
        {v.title}
      </h2>
    </div>

    <!-- 2-column grid for Nuestros clientes and Nuestro personal -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {
        v.pillars.map((pillar, idx) => (
          <article
            class="bg-white p-8"
            data-animate="fade-up"
            data-animate-delay={String((idx + 1) * 100)}
          >
            <h3 class="text-xl font-bold text-accent tracking-tight">
              {pillar.title}
            </h3>
            <p class="mt-3 text-base leading-relaxed text-slate-600">
              {pillar.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
