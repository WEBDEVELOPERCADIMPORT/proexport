---
import type { Lang } from '../../../i18n/config.i18n';
import aboutContent from '../../../data/site-about-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = aboutContent[lang] ?? aboutContent.es;
const m = t.mission;
---

<section class="w-full grid grid-cols-1 lg:grid-cols-2">
  <!-- Left: Solid #0072B5 (bg-sky) block with white text -->
  <div class="bg-sky text-white px-8 py-14 sm:px-14 lg:px-16 xl:px-24 lg:py-20 flex flex-col justify-center">
    <div class="max-w-xl" data-animate="slide-in-left">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
        {m.title}
      </h2>
      <div class="mt-3 w-14 h-[3px] bg-gold rounded-full" aria-hidden="true"></div>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-white/95">
        {m.description}
      </p>
    </div>
  </div>

  <!-- Right: Full-bleed team photo -->
  <div class="relative min-h-[300px] lg:min-h-[400px]" data-animate="fade-in" data-animate-delay="200">
    <img
      src={m.image}
      alt={m.title}
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="lazy"
    />
  </div>
</section>
